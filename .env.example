# =============================================
# MealConnect - Environment Variables
# =============================================
# Copy this file to .env in the project root
# and fill in your values.
# =============================================

# JWT Secret for authentication tokens
# IMPORTANT: Change this to a strong, random secret in production!
JWT_SECRET=your-secret-key-change-this

# (Optional) Override MongoDB connection string
# Default in Docker: mongodb://mongo:27017/mealconnect
# MONGO_URI=mongodb://mongo:27017/mealconnect

# (Optional) Override MongoDB database name
# MONGO_DB=mealconnect

# (Optional) Override backend port
# PORT=5001

# (Optional) Override frontend URL for CORS
# FRONTEND_URL=http://localhost
